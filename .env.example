# Environment Configuration for Infinity Intelligence System

# Server
PORT=8080
HOST=0.0.0.0

# Google Cloud
GCP_PROJECT_ID=infinity-x-one-systems
FIRESTORE_COLLECTION=infinity-intelligence
PUBSUB_TOPIC=infinity-intelligence-events

# AI Services
VISION_API_ENDPOINT=https://vision.googleapis.com/v1
VERTEX_AI_ENDPOINT=https://us-central1-aiplatform.googleapis.com

# System Configuration
CRAWLER_CONCURRENCY=10
AGENT_POOL_SIZE=20
LOG_LEVEL=info

# Domain
DOMAIN=infinityxai.com

# GitHub
GITHUB_TOKEN=your_github_token_here

# Google Workspace
GOOGLE_WORKSPACE_DOMAIN=infinityxai.com

# Secrets (set in Google Cloud Secrets Manager or environment)
# GCP_SERVICE_ACCOUNT_KEY=...
# FIREBASE_CONFIG=...